---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, linkWhatsApp, CONTATO } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 3);

const servicos = [
  { nome: 'Corte Cacheado', desc: 'Corte que valoriza o formato natural do seu cacho, fio a fio.', foto: '/fotos/servicos/corte.jpg' },
  { nome: 'Terapia Capilar', desc: 'Diagnóstico e tratamento do couro cabeludo para cachos saudáveis.', foto: '/fotos/servicos/terapia.jpg' },
  { nome: 'Protocolos', desc: 'Protocolos exclusivos pra devolver maciez, brilho, definição e movimento.', foto: '/fotos/servicos/protocolos.jpg' },
  { nome: 'Mechas em Cachos', desc: 'Iluminado sob medida, sem abrir mão da definição e da saúde do fio.', foto: '/fotos/servicos/mechas.jpg' },
];
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__texto">
        <span class="eyebrow">Salão de cachos · {SITE.cidade}</span>
        <h1>Seu cacho merece<br /><em>cuidado de verdade.</em></h1>
        <p class="lead">
          No Espaço Lu Ribeiro a gente cuida do seu cabelo cacheado de raiz —
          com corte, tratamento, terapia capilar e mechas feitos pra realçar o
          que é seu.
        </p>
        <div class="hero__acoes">
          <a href={linkWhatsApp()} class="btn btn-primario" target="_blank" rel="noopener">Agendar meu horário</a>
          <a href="/servicos" class="btn btn-contorno">Ver serviços</a>
        </div>
        <p class="hero__ig">
          Acompanhe no Instagram
          <a href={CONTATO.instagram} target="_blank" rel="noopener">{CONTATO.instagramHandle}</a>
        </p>
      </div>
      <div class="hero__arte">
        <div class="hero__foto">
          <img
            src="/fotos/hero-lu.jpg"
            alt="Lu Ribeiro, especialista em cachos, no Espaço Lu Ribeiro"
            width="825" height="1100" loading="eager"
          />
        </div>
        <div class="hero__card">
          <span class="hero__card-emoji">💛</span>
          <p>“Aqui a cliente aprende a amar o próprio cabelo.”</p>
          <small>— Lu Ribeiro</small>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section class="section">
    <div class="container">
      <div class="center" style="margin-bottom: 2.5rem;">
        <span class="eyebrow">O que fazemos</span>
        <h2>Cuidado completo, do fio ao couro cabeludo</h2>
      </div>
      <div class="grid grid-4">
        {servicos.map((s) => (
          <div class="card servico">
            <img class="servico__foto" src={s.foto} alt={`${s.nome} no Espaço Lu Ribeiro`} loading="lazy" width="675" height="900" />
            <h3>{s.nome}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="center" style="margin-top: 2.5rem;">
        <a href="/servicos" class="btn btn-contorno">Ver todos os serviços</a>
      </div>
    </div>
  </section>

  <!-- FAIXA TERAPIA -->
  <section class="faixa">
    <div class="container faixa__inner">
      <div>
        <span class="eyebrow">Nosso diferencial</span>
        <h2>Terapia capilar: a raiz da beleza</h2>
        <p class="faixa__texto">
          Cabelo bonito começa num couro cabeludo saudável. Antes de qualquer
          tratamento, a gente entende o seu — pra tratar a causa, não só o
          sintoma. É assim que o resultado dura.
        </p>
        <a href="/servicos" class="btn btn-primario">Entender a terapia capilar</a>
      </div>
      <div class="faixa__numeros">
        <div><strong>+15</strong><span>anos cuidando de cachos</span></div>
        <div><strong>100%</strong><span>foco em cabelo cacheado</span></div>
        <div><strong>1:1</strong><span>atendimento com hora marcada</span></div>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="secao-topo">
          <div>
            <span class="eyebrow">Do nosso blog</span>
            <h2>Dicas pra cuidar dos seus cachos em casa</h2>
          </div>
          <a href="/blog" class="btn btn-contorno">Ver o blog</a>
        </div>
        <div class="grid grid-3">
          {posts.map((post) => (
            <PostCard
              slug={post.id}
              titulo={post.data.titulo}
              resumo={post.data.resumo}
              data={post.data.data}
              categoria={post.data.categoria}
              capa={post.data.capa}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- POR DENTRO DO ESPAÇO (vídeos) -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="center" style="margin-bottom: 2.5rem;">
        <span class="eyebrow">Por dentro do Espaço</span>
        <h2>Um atendimento sem pressa, feito pra você</h2>
      </div>
      <figure class="video video--principal">
        <video src="/videos/atendimento.mp4" poster="/videos/atendimento.jpg" controls playsinline preload="none" width="720" height="1280"></video>
        <figcaption>Um dia de atendimento no Espaço Lu Ribeiro, com a Lu</figcaption>
      </figure>
      <div class="videos">
        <figure class="video">
          <video src="/videos/head-spa.mp4" poster="/videos/head-spa.jpg" autoplay muted loop playsinline preload="metadata"></video>
          <figcaption>Head Spa: cuidado e relaxamento</figcaption>
        </figure>
        <figure class="video">
          <video src="/videos/iluminado.mp4" poster="/videos/iluminado.jpg" autoplay muted loop playsinline preload="metadata"></video>
          <figcaption>Iluminado que preserva o cacho</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="secao-topo">
        <div>
          <span class="eyebrow">No dia a dia</span>
          <h2>Do nosso Instagram</h2>
        </div>
        <a href={CONTATO.instagram} target="_blank" rel="noopener" class="btn btn-contorno">
          Seguir {CONTATO.instagramHandle}
        </a>
      </div>
      <div class="ig-grid">
        {Array.from({ length: 15 }, (_, i) => `dia/${i + 1}`).map((f) => (
          <a href={CONTATO.instagram} target="_blank" rel="noopener" class="ig-item" aria-label="Ver no Instagram">
            <img src={`/fotos/${f}.jpg`} alt="Cachos finalizados no Espaço Lu Ribeiro" loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="container">
    <div class="cta-final">
      <h2 class="text-creme">Pronta pra transformar seus cachos?</h2>
      <p>Agende pelo WhatsApp e venha viver a experiência Lu Ribeiro.</p>
      <a href={linkWhatsApp()} class="btn btn-primario" target="_blank" rel="noopener">Agendar agora</a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    background:
      radial-gradient(1200px 500px at 80% -10%, var(--areia), transparent),
      var(--creme);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }
  .hero h1 em { font-style: italic; color: var(--primaria); }
  .hero__acoes { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.8rem 0 1.4rem; }
  .hero__ig { font-size: 0.95rem; color: var(--tinta-suave); }
  .hero__ig a { font-weight: 700; margin-left: 0.3rem; }

  .hero__arte { position: relative; display: flex; justify-content: center; }
  .hero__foto {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 361 / 640;
    border-radius: 200px 200px 6px 6px;
    overflow: hidden;
    border: 1px solid var(--primaria);
    outline: 8px solid var(--branco);
    box-shadow: var(--sombra);
  }
  .hero__foto img { width: 100%; height: 100%; object-fit: cover; }
  .hero__card {
    position: absolute;
    left: -0.5rem;
    bottom: -1.2rem;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    box-shadow: var(--sombra);
    padding: 1.2rem 1.4rem;
    max-width: 230px;
    text-align: center;
  }
  .hero__card-emoji { font-size: 2rem; }
  .hero__card p { font-family: var(--serif); font-style: italic; font-size: 1.15rem; margin: 0.6rem 0 0.4rem; }
  .hero__card small { color: var(--primaria-escura); font-weight: 700; }

  /* Serviços */
  .servico { padding: 0 0 1.6rem; text-align: center; }
  .servico h3, .servico p { padding-inline: 1.4rem; }
  .servico__foto { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 35%; margin-bottom: 1.2rem; }
  .servico p { color: var(--tinta-suave); font-size: 1rem; margin: 0; }

  /* Faixa terapia */
  .faixa {
    background: radial-gradient(900px 420px at 15% 0%, var(--branco), transparent), var(--creme-2);
    border-block: 1px solid var(--borda);
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .faixa__inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: center; }
  .faixa__texto { color: var(--tinta-suave); font-size: 1.1rem; margin-bottom: 1.6rem; }
  .faixa__numeros { display: grid; gap: 1.2rem; }
  .faixa__numeros div {
    background: var(--branco);
    border: 1px solid var(--borda);
    box-shadow: var(--sombra-sm);
    border-radius: var(--raio);
    padding: 1.2rem 1.4rem;
  }
  .faixa__numeros strong { font-family: var(--serif); font-size: 2.2rem; color: var(--primaria); display: block; }
  .faixa__numeros span { color: var(--tinta-suave); font-size: 0.95rem; }

  .grid-4 { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }

  /* Blog topo */
  .secao-topo { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 2.2rem; flex-wrap: wrap; }

  /* Instagram */
  .ig-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.8rem; }
  .ig-item {
    aspect-ratio: 3 / 4;
    border-radius: var(--raio-sm);
    overflow: hidden;
    box-shadow: var(--sombra-sm);
    display: block;
  }
  .ig-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
  .ig-item:hover img { transform: scale(1.06); }
  @media (max-width: 720px) {
    .ig-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Vídeos */
  .videos { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; align-items: start; max-width: 620px; margin: 2rem auto 0; }
  .video--principal { max-width: 460px; margin-inline: auto; }
  .video--principal video { border: 1px solid var(--primaria); outline: 6px solid var(--branco); box-shadow: var(--sombra); }
  .video { margin: 0; }
  .video video {
    width: 100%; aspect-ratio: 9 / 16; object-fit: cover; display: block;
    background: var(--creme-2);
    border-radius: 4px;
    border: 1px solid var(--borda);
    box-shadow: var(--sombra-sm);
  }
  .video figcaption { font-size: 0.85rem; color: var(--tinta-suave); text-align: center; margin-top: 0.6rem; }
  @media (max-width: 720px) {
    .video--principal { max-width: 100%; }
  }

  /* CTA final */
  .cta-final {
    background: var(--ouro);
    border-radius: 4px;
    padding: clamp(2.5rem, 6vw, 4rem);
    text-align: center;
    margin-block: 1rem 3rem;
  }
  .cta-final p { color: #fff8ec; font-size: 1.15rem; margin-bottom: 1.6rem; }
  .cta-final .btn-primario { background: #fff; color: var(--terracota-escuro); }
  .cta-final .btn-primario:hover { background: var(--creme); }

  @media (max-width: 860px) {
    .hero__inner, .faixa__inner { grid-template-columns: 1fr; }
    .hero__arte { min-height: 260px; }
  }
</style>
